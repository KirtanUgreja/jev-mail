# Copy to .env (same folder as manifest.json) and fill in one key.
# .env is gitignored. Reload the extension on chrome://extensions after editing.
#
# With both keys set, OpenRouter is used unless JEV_PROVIDER=typesafe.
# A key typed in the extension's Settings overrides the one here.

OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Optional
# JEV_PROVIDER=typesafe
# JEV_MODEL=jev-1.13
